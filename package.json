{
  "name": "preact-template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm --parallel --fail-if-no-match --filter @apps/* dev",
    "dev:landing": "pnpm --filter @apps/landing dev",
    "dev:agreement": "pnpm --filter @apps/agreement dev",
    "build:test": "pnpm --fail-if-no-match --filter @apps/* build:test",
    "build:prod": "pnpm --fail-if-no-match --filter @apps/* build:prod",
    "preview:test": "pnpm --parallel --fail-if-no-match --filter @apps/* preview:test",
    "preview:prod": "pnpm --parallel --fail-if-no-match --filter @apps/* preview:prod",
    "typecheck": "tsc --noEmit && pnpm --filter @apps/agreement check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:browser": "pnpm --filter @packages/browser test:build && playwright test",
    "test:browser:dev": "playwright test --config playwright.dev.config.ts",
    "check:build": "node scripts/check-build.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.0.0",
    "@types/postcss-pxtorem": "6.1.0",
    "@vitejs/plugin-legacy": "8.2.3",
    "acorn": "^8.18.0",
    "autoprefixer": "^10.5.5",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "postcss-custom-properties": "^15.0.1",
    "postcss-pxtorem": "6.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "terser": "^5.51.2",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.70.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
