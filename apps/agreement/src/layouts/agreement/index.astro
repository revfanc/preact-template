---
import '../../style.css';
interface Props {
  title: string;
}
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="app-env" content={import.meta.env.VITE_APP_ENV} />
    <title>{title}</title>
  </head>
  <body>
    <main><slot /></main>
    <script
      is:inline
      id="agreement-runtime"
      src={`${base}runtime/agreement.js`}
      defer></script>
  </body>
</html>
